# Mirror of ccs.wup.shop.nintendo.net for the Wii U Download Management, see
# README.md. Install as /etc/systemd/system/ccs-mirror.service.
[Unit]
Description=Mirror of ccs.wup.shop.nintendo.net answered from the public Wii U CDN
After=network-online.target
Wants=network-online.target

[Service]
# CCS_MIRROR_ALLOW: the public IP of your home, see README.md.
EnvironmentFile=/etc/ccs-mirror/env
# The keys stay root only, systemd hands them to the service as credentials
# (%d is the directory they show up in).
LoadCredential=cert:/etc/ccs-mirror/cert-chain.pem
LoadCredential=key:/etc/ccs-mirror/ssl-cert-private-key.pem
ExecStart=/usr/bin/python3 /opt/ccs-mirror/ccs_mirror.py --cert %d/cert --key %d/key --allow ${CCS_MIRROR_ALLOW}
Restart=on-failure

# No root: port 443 through the one capability it needs.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
